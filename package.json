 "devDependencies": {
  "@eslint/js": "^10.1.0",
  "@playwright/test": "^1.48.0",
  "@testing-library/jest-dom": "^6.6.3",
  "@testing-library/react": "^16.0.1",
  "@testing-library/user-event": "^14.5.2",
  "@types/node": "^22.9.0",
  "@types/react": "^18.3.12",
  "@types/react-dom": "^18.3.1",
  "@vitejs/plugin-react": "^4.3.3",
  "@vitest/ui": "^2.1.5",
  "eslint": "^9.14.0",
